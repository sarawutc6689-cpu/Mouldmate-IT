<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Helpdesk · รายงาน</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI','Sarabun',Tahoma,Geneva,Verdana,sans-serif;}
        :root{--primary:#2b6ed3;--primary-light:#e8f0fe;--primary-soft:#d4e2fc;--primary-bg:#f5f9ff;--white:#ffffff;--gray-50:#f8fafc;--gray-200:#e2e8f0;--gray-300:#cbd5e1;--gray-600:#475569;--gray-700:#334155;--gray-800:#1e293b;--success:#10b981;--warning:#f59e0b;--danger:#ef4444;--info:#3b82f6;}
        body{background:var(--primary-bg);min-height:100vh;display:flex;font-size:14px;}
        .sidebar{width:280px;background:var(--white);height:100vh;position:fixed;left:0;top:0;box-shadow:4px 0 20px rgba(0,45,90,0.05);overflow-y:auto;z-index:1000;border-right:1px solid var(--gray-200);}
        .sidebar-header{padding:30px 24px;background:var(--white);border-bottom:1px solid var(--gray-200);text-align:center;}
        .sidebar-header i{font-size:48px;color:var(--primary);margin-bottom:12px;background:var(--primary-light);padding:16px;border-radius:20px;}
        .sidebar-header h2{font-size:20px;font-weight:600;color:var(--gray-800);margin-bottom:4px;}
        .sidebar-header p{font-size:13px;color:var(--gray-600);}
        .sidebar-menu{padding:20px 16px;}
        .menu-item{display:flex;align-items:center;padding:12px 20px;color:var(--gray-600);transition:all 0.2s;cursor:pointer;text-decoration:none;border-radius:12px;margin-bottom:4px;font-weight:500;}
        .menu-item:hover{background:var(--primary-light);color:var(--primary);}
        .menu-item.active{background:var(--primary-light);color:var(--primary);font-weight:600;}
        .menu-item i{width:24px;font-size:18px;margin-right:12px;}
        .menu-item span{flex:1;}
        .menu-badge{background:var(--primary-light);color:var(--primary);padding:4px 8px;border-radius:30px;font-size:11px;font-weight:600;}
        .sidebar-footer{padding:20px 24px;border-top:1px solid var(--gray-200);position:absolute;bottom:0;width:100%;background:var(--white);}
        .user-info{display:flex;align-items:center;gap:12px;}
        .user-avatar{width:44px;height:44px;background:var(--primary-light);color:var(--primary);border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:18px;}
        .user-details{flex:1;}.user-name{font-weight:600;color:var(--gray-800);font-size:14px;}.user-role{font-size:12px;color:var(--gray-600);}
        .main-content{flex:1;margin-left:280px;padding:24px;}
        .container{max-width:1400px;margin:0 auto;}
        .header{background:var(--white);border-radius:20px;padding:20px 28px;margin-bottom:24px;box-shadow:0 2px 12px rgba(0,45,90,0.03);border:1px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between;}
        .header h1{color:var(--gray-800);font-size:22px;font-weight:600;display:flex;align-items:center;gap:12px;}
        .header h1 i{color:var(--primary);font-size:24px;}
        .btn{padding:10px 20px;border:none;border-radius:12px;cursor:pointer;font-weight:500;display:flex;align-items:center;gap:8px;transition:all 0.2s;font-size:14px;}
        .btn-refresh{background:var(--white);color:var(--gray-600);border:1px solid var(--gray-200);}.btn-refresh:hover{background:var(--primary-light);color:var(--primary);}
        .filter-section{background:var(--white);border-radius:18px;padding:20px;margin-bottom:24px;border:1px solid var(--gray-200);}
        .filter-title{display:flex;align-items:center;gap:8px;margin-bottom:16px;color:var(--gray-800);font-size:16px;font-weight:600;}
        .filter-title i{color:var(--primary);}
        .filter-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
        .filter-group{display:flex;flex-direction:column;gap:6px;}
        .filter-group label{color:var(--gray-600);font-size:13px;font-weight:500;display:flex;align-items:center;gap:6px;}
        .filter-group label i{color:var(--primary);font-size:12px;}
        .filter-group input,.filter-group select{padding:10px 14px;border:1px solid var(--gray-200);border-radius:10px;font-size:13px;transition:all 0.2s;background:var(--white);}
        .filter-group input:focus,.filter-group select:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-light);}
        .filter-actions{display:flex;gap:10px;align-items:flex-end;}
        .filter-actions button{padding:10px 20px;border:none;border-radius:10px;cursor:pointer;font-weight:500;font-size:13px;display:flex;align-items:center;gap:6px;transition:all 0.2s;}
        .btn-filter{background:var(--primary);color:white;flex:1;}.btn-filter:hover{background:#1e5bbf;}
        .btn-reset{background:var(--white);color:var(--gray-600);border:1px solid var(--gray-200);}
        .summary-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;margin-bottom:24px;}
        .summary-card{background:var(--white);border-radius:18px;padding:20px;box-shadow:0 2px 12px rgba(0,45,90,0.03);border:1px solid var(--gray-200);transition:all 0.2s;}
        .summary-card:hover{border-color:var(--primary-soft);}
        .summary-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px;}
        .summary-icon.total{background:#e0e7ff;color:#4f46e5;}.summary-icon.pending{background:#fef3c7;color:#d97706;}
        .summary-icon.progress{background:#dbeafe;color:#2563eb;}.summary-icon.completed{background:#d1fae5;color:#059669;}
        .summary-icon.assignees{background:#f3e8ff;color:#9333ea;}
        .summary-value{font-size:28px;font-weight:700;color:var(--gray-800);margin-bottom:4px;}
        .summary-label{color:var(--gray-600);font-size:13px;font-weight:500;}
        .charts-row{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:24px;}
        .chart-card{background:var(--white);border-radius:18px;padding:20px;box-shadow:0 2px 12px rgba(0,45,90,0.03);border:1px solid var(--gray-200);}
        .chart-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
        .chart-header h3{color:var(--gray-800);font-size:16px;font-weight:600;display:flex;align-items:center;gap:8px;}
        .chart-header h3 i{color:var(--primary);}
        .chart-container{height:280px;position:relative;}
        .table-section{background:var(--white);border-radius:20px;padding:20px;border:1px solid var(--gray-200);margin-bottom:24px;}
        .table-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
        .table-header h3{color:var(--gray-800);font-size:16px;font-weight:600;display:flex;align-items:center;gap:8px;}
        .table-header h3 i{color:var(--primary);}
        .export-options{display:flex;gap:8px;}
        .export-btn{padding:8px 16px;border:1px solid var(--gray-200);border-radius:30px;background:var(--white);color:var(--gray-600);font-size:12px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all 0.2s;}
        .export-btn:hover{background:var(--primary-light);color:var(--primary);border-color:var(--primary);}
        .table-wrapper{overflow-x:auto;}
        table{width:100%;border-collapse:collapse;min-width:1200px;}
        th{text-align:left;padding:14px 12px;background:var(--gray-50);color:var(--gray-600);font-weight:600;font-size:13px;border-bottom:1px solid var(--gray-200);}
        td{padding:14px 12px;border-bottom:1px solid var(--gray-200);color:var(--gray-700);font-size:13px;}
        tr:hover td{background:var(--gray-50);}
        .ticket-id{font-weight:600;color:var(--primary);}
        .status-badge{padding:4px 12px;border-radius:30px;font-size:11px;font-weight:600;display:inline-block;}
        .status-pending{background:#fef3c7;color:#92400e;}.status-progress{background:#dbeafe;color:#1e40af;}.status-completed{background:#d1fae5;color:#065f46;}
        .img-thumb{cursor:pointer;color:var(--primary);font-weight:500;display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:var(--primary-light);border-radius:20px;transition:all 0.2s;font-size:12px;}
        .img-thumb:hover{background:var(--primary);color:white;}
        .pagination{display:flex;justify-content:space-between;align-items:center;margin-top:20px;padding-top:20px;border-top:1px solid var(--gray-200);}
        .pagination-info{color:var(--gray-600);font-size:13px;}
        .pagination-controls{display:flex;gap:8px;}
        .pagination-btn{padding:8px 16px;border:1px solid var(--gray-200);border-radius:30px;background:var(--white);color:var(--gray-600);font-size:13px;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all 0.2s;}
        .pagination-btn:hover:not(:disabled){background:var(--primary-light);color:var(--primary);border-color:var(--primary);}
        .pagination-btn:disabled{opacity:0.5;cursor:not-allowed;}
        .loading{text-align:center;padding:40px;color:var(--gray-600);}
        .loading i{font-size:32px;color:var(--primary);margin-bottom:12px;}

        /* Modal สำหรับดูรูปภาพ */
        .modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:2000;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
        .modal-overlay.active{display:flex;}
        .modal-container{background:var(--white);border-radius:24px;width:90%;max-width:700px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 40px rgba(0,0,0,0.2);animation:modalIn 0.25s ease;}
        @keyframes modalIn{from{opacity:0;transform:scale(0.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
        .modal-header{padding:16px 24px;border-bottom:1px solid var(--gray-200);display:flex;justify-content:space-between;align-items:center;background:var(--primary-light);border-radius:24px 24px 0 0;}
        .modal-header h3{color:var(--gray-800);font-size:18px;font-weight:600;display:flex;align-items:center;gap:8px;}
        .modal-header h3 i{color:var(--primary);}
        .modal-close{background:none;border:none;font-size:24px;cursor:pointer;color:var(--gray-600);padding:0 8px;transition:all 0.2s;}
        .modal-close:hover{color:var(--danger);transform:rotate(90deg);}
        .modal-body{padding:24px;}
        .modal-body .image-grid{display:flex;flex-wrap:wrap;gap:15px;justify-content:center;}
        .modal-body .image-grid a{display:block;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);transition:all 0.2s;}
        .modal-body .image-grid a:hover{transform:scale(1.03);box-shadow:0 4px 16px rgba(0,0,0,0.15);}
        .modal-body .image-grid img{width:100%;max-width:280px;max-height:280px;object-fit:cover;display:block;}

        footer{text-align:center;padding:20px;color:var(--gray-600);font-size:12px;border-top:1px solid var(--gray-200);}
        @media(max-width:1200px){.summary-grid{grid-template-columns:repeat(3,1fr)}.charts-row{grid-template-columns:1fr}.filter-grid{grid-template-columns:repeat(2,1fr)}}
        @media(max-width:768px){.sidebar{width:0;display:none}.main-content{margin-left:0}.summary-grid{grid-template-columns:repeat(2,1fr)}.filter-grid{grid-template-columns:1fr}.header{flex-direction:column;gap:12px}.export-options{flex-wrap:wrap}}
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header"><i class="fas fa-headset"></i><h2>IT Helpdesk</h2><p>ระบบแจ้งซ่อมออนไลน์</p></div>
        <div class="sidebar-menu">
            <a href="dashboard.html" class="menu-item"><i class="fas fa-chart-pie"></i><span>แดชบอร์ด</span><span class="menu-badge" id="menuTotal">-</span></a>
            <a href="index.html" class="menu-item"><i class="fas fa-plus-circle"></i><span>แจ้งปัญหา</span></a>
            <a href="login.html" class="menu-item"><i class="fas fa-clipboard-check"></i><span>รอดำเนินงาน</span><span class="menu-badge" id="menuPending">-</span></a>
            <a href="track.html" class="menu-item"><i class="fas fa-search"></i><span>ติดตามสถานะ</span></a>
            <a href="report.html" class="menu-item active"><i class="fas fa-file-alt"></i><span>รายงาน</span></a>
        </div>
        <div class="sidebar-footer"><div class="user-info"><div class="user-avatar">SC</div><div class="user-details"><div class="user-name">พัฒนาระบบโดย</div><div class="user-role">Sarawut.C</div></div></div></div>
    </div>

    <div class="main-content">
        <div class="container">
            <div class="header">
                <h1><i class="fas fa-file-alt"></i> รายงาน</h1>
                <button class="btn btn-refresh" onclick="loadReportData()"><i class="fas fa-sync-alt"></i></button>
            </div>

            <div class="filter-section">
                <div class="filter-title"><i class="fas fa-filter"></i><span>ตัวกรองรายงาน</span></div>
                <div class="filter-grid">
                    <div class="filter-group"><label><i class="fas fa-calendar"></i> วันที่เริ่มต้น</label><input type="date" id="startDate"></div>
                    <div class="filter-group"><label><i class="fas fa-calendar"></i> วันที่สิ้นสุด</label><input type="date" id="endDate"></div>
                    <div class="filter-group"><label><i class="fas fa-tag"></i> สถานะ</label>
                        <select id="statusFilter"><option value="">ทั้งหมด</option><option value="รอดำเนินการ">รอดำเนินการ</option><option value="กำลังดำเนินการ">กำลังดำเนินการ</option><option value="เสร็จสิ้น">เสร็จสิ้น</option></select>
                    </div>
                    <div class="filter-group"><label><i class="fas fa-building"></i> แผนก</label><select id="deptFilter"><option value="">ทั้งหมด</option></select></div>
                    <div class="filter-group"><label><i class="fas fa-user-tie"></i> ผู้รับผิดชอบ</label>
                        <select id="assigneeFilter"><option value="">ทั้งหมด</option><option value="พงศ์ระพี">พงศ์ระพี</option><option value="ศราวุธ">ศราวุธ</option></select>
                    </div>
                    <div class="filter-group"><label><i class="fas fa-sort"></i> เรียงตาม</label>
                        <select id="sortBy"><option value="date">วันที่</option><option value="ticketId">Ticket ID</option><option value="status">สถานะ</option></select>
                    </div>
                    <div class="filter-actions">
                        <button class="btn-filter" onclick="applyFilter()"><i class="fas fa-search"></i> แสดงรายงาน</button>
                        <button class="btn-reset" onclick="resetFilter()"><i class="fas fa-undo-alt"></i></button>
                    </div>
                </div>
            </div>

            <div class="summary-grid">
                <div class="summary-card"><div class="summary-icon total"><i class="fas fa-ticket-alt"></i></div><div class="summary-value" id="totalTickets">0</div><div class="summary-label">Ticket ทั้งหมด</div></div>
                <div class="summary-card"><div class="summary-icon pending"><i class="fas fa-clock"></i></div><div class="summary-value" id="pendingTickets">0</div><div class="summary-label">รอดำเนินการ</div></div>
                <div class="summary-card"><div class="summary-icon progress"><i class="fas fa-spinner"></i></div><div class="summary-value" id="progressTickets">0</div><div class="summary-label">กำลังดำเนินการ</div></div>
                <div class="summary-card"><div class="summary-icon completed"><i class="fas fa-check-circle"></i></div><div class="summary-value" id="completedTickets">0</div><div class="summary-label">เสร็จสิ้น</div></div>
                <div class="summary-card"><div class="summary-icon assignees"><i class="fas fa-users"></i></div><div class="summary-value" id="assigneeCount">0</div><div class="summary-label">ผู้รับผิดชอบ</div></div>
            </div>

            <div class="charts-row">
                <div class="chart-card"><div class="chart-header"><h3><i class="fas fa-chart-pie"></i> สัดส่วนตามสถานะ</h3></div><div class="chart-container"><canvas id="statusChart"></canvas></div></div>
                <div class="chart-card"><div class="chart-header"><h3><i class="fas fa-chart-line"></i> สถิติรายวัน</h3></div><div class="chart-container"><canvas id="dailyChart"></canvas></div></div>
            </div>

            <div class="table-section">
                <div class="table-header">
                    <h3><i class="fas fa-list"></i> รายละเอียด Ticket</h3>
                    <div class="export-options">
                        <button class="export-btn" onclick="exportToCSV()"><i class="fas fa-file-excel" style="color:#10b981;"></i> Excel/CSV</button>
                        <button class="export-btn" onclick="printReport()"><i class="fas fa-print" style="color:var(--primary);"></i> พิมพ์</button>
                    </div>
                </div>
                <div id="loadingMessage" class="loading" style="display:none;"><i class="fas fa-spinner fa-pulse"></i><p>กำลังโหลดข้อมูล...</p></div>
                <div class="table-wrapper" id="tableContent">
                    <table>
                        <thead>
                            <tr>
                                <th>ลำดับ</th>
                                <th>Ticket ID</th>
                                <th>วันที่</th>
                                <th>ผู้แจ้ง</th>
                                <th>แผนก</th>
                                <th>ประเภท</th>
                                <th>อุปกรณ์</th>
                                <th>เบอร์โทร</th>
                                <th>สถานะ</th>
                                <th>รูปภาพ</th>
                                <th>ผู้รับผิดชอบ</th>
                                <th>ระยะเวลา</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody"><tr><td colspan="12" style="text-align:center;padding:40px;">กำลังโหลด...</td></tr></tbody>
                    </table>
                </div>
                <div class="pagination">
                    <div class="pagination-info" id="paginationInfo">แสดง 0 - 0 จาก 0 รายการ</div>
                    <div class="pagination-controls">
                        <button class="pagination-btn" id="prevBtn" onclick="prevPage()" disabled><i class="fas fa-chevron-left"></i> ก่อนหน้า</button>
                        <span style="padding:8px 16px;color:var(--gray-600);">หน้า <span id="currentPage">1</span>/<span id="totalPages">1</span></span>
                        <button class="pagination-btn" id="nextBtn" onclick="nextPage()" disabled>ถัดไป <i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>
            </div>

            <footer><p>IT Helpdesk Report © 2026 | Tokaisolidtire</p><p>ใช้สำหรับภายในบริษัทเท่านั้น</p></footer>
        </div>
    </div>

    <!-- Modal สำหรับดูรูปภาพ -->
    <div class="modal-overlay" id="imageModal">
        <div class="modal-container">
            <div class="modal-header">
                <h3><i class="fas fa-image"></i> <span id="imageModalTitle">รูปภาพประกอบ</span></h3>
                <button class="modal-close" onclick="closeImageModal()">&times;</button>
            </div>
            <div class="modal-body" id="imageModalBody">
                <div class="image-grid" id="imageGrid"></div>
            </div>
        </div>
    </div>

    <script>
        // ============================================================
        // Supabase config — ใส่ Project URL และ anon key ของคุณตรงนี้
        // ============================================================
        const SUPABASE_URL      = 'YOUR_SUPABASE_URL';
        const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let allTickets = [], filteredTickets = [];
        let currentPage = 1, rowsPerPage = 20;
        let statusChart, dailyChart;

        // แปลงคอลัมน์ snake_case จาก Supabase ให้เป็น shape เดิม (camelCase) ที่โค้ดส่วนที่เหลือใช้อยู่
        function mapTicketRow(row) {
            return {
                timestamp: row.created_at,
                name: row.name,
                department: row.department,
                issueType: row.issue_type,
                device: row.device,
                details: row.details,
                phone: row.phone,
                ticketId: row.ticket_id,
                status: row.status,
                assignee: row.assignee,
                closeDate: row.close_date,
                note: row.note,
                computerName: row.computer_name,
                historyCount: row.history_count,
                lastUpdated: row.last_updated,
                detailsUpdate: row.details_update,
                imageUrls: row.image_urls || []
            };
        }

        document.addEventListener('DOMContentLoaded', function() {
            setDefaultDates();
            setTimeout(loadReportData, 100);
        });

        function setDefaultDates() {
            const today = new Date();
            const first = new Date(today.getFullYear(), today.getMonth(), 1);
            document.getElementById('startDate').value = fmt(first);
            document.getElementById('endDate').value = fmt(today);
        }

        function fmt(d) { return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }

        async function loadReportData() {
            showLoading(true);
            try {
                const { data, error } = await supabase
                    .from('tickets')
                    .select('*')
                    .order('created_at', { ascending: false });
                if (error) throw error;
                allTickets = (data || []).map(mapTicketRow);
                populateDeptFilter();
                applyFilter();
                updateMenuBadges();
                showLoading(false);
            } catch (error) {
                alert('เกิดข้อผิดพลาด: ' + (error.message || error));
                showLoading(false);
            }
        }

        function populateDeptFilter() {
            const select = document.getElementById('deptFilter');
            while (select.options.length > 1) select.remove(1);
            [...new Set(allTickets.map(t => t.department).filter(d => d))].forEach(dept => {
                const o = document.createElement('option'); o.value = dept; o.textContent = dept; select.appendChild(o);
            });
        }

        function showLoading(show) {
            document.getElementById('loadingMessage').style.display = show ? 'block' : 'none';
            document.getElementById('tableContent').style.display = show ? 'none' : 'block';
        }

        function updateMenuBadges() {
            document.getElementById('menuTotal').textContent = allTickets.length;
            document.getElementById('menuPending').textContent = allTickets.filter(t => t.status==='รอดำเนินการ').length;
        }

        function applyFilter() {
            const startDate = new Date(document.getElementById('startDate').value);
            const endDate = new Date(document.getElementById('endDate').value);
            endDate.setHours(23, 59, 59);
            const status = document.getElementById('statusFilter').value;
            const dept = document.getElementById('deptFilter').value;
            const assignee = document.getElementById('assigneeFilter').value;
            const sortBy = document.getElementById('sortBy').value;

            filteredTickets = allTickets.filter(t => {
                if (!t.timestamp) return false;
                const d = new Date(t.timestamp);
                if (d < startDate || d > endDate) return false;
                if (status && t.status !== status) return false;
                if (dept && t.department !== dept) return false;
                if (assignee && t.assignee !== assignee) return false;
                return true;
            });

            filteredTickets.sort((a, b) => {
                if (sortBy === 'date') return new Date(b.timestamp) - new Date(a.timestamp);
                if (sortBy === 'ticketId') return (b.ticketId||'').localeCompare(a.ticketId||'');
                return (a.status||'').localeCompare(b.status||'');
            });

            updateSummary(); updateCharts(); currentPage = 1; renderTable();
        }

        function resetFilter() { setDefaultDates(); document.getElementById('statusFilter').value=''; document.getElementById('deptFilter').value=''; document.getElementById('assigneeFilter').value=''; document.getElementById('sortBy').value='date'; applyFilter(); }

        function updateSummary() {
            document.getElementById('totalTickets').textContent = filteredTickets.length;
            document.getElementById('pendingTickets').textContent = filteredTickets.filter(t=>t.status==='รอดำเนินการ').length;
            document.getElementById('progressTickets').textContent = filteredTickets.filter(t=>t.status==='กำลังดำเนินการ').length;
            document.getElementById('completedTickets').textContent = filteredTickets.filter(t=>t.status==='เสร็จสิ้น').length;
            document.getElementById('assigneeCount').textContent = new Set(filteredTickets.map(t=>t.assignee).filter(a=>a)).size;
        }

        function updateCharts() {
            const pending = filteredTickets.filter(t=>t.status==='รอดำเนินการ').length;
            const progress = filteredTickets.filter(t=>t.status==='กำลังดำเนินการ').length;
            const completed = filteredTickets.filter(t=>t.status==='เสร็จสิ้น').length;
            if (statusChart) statusChart.destroy();
            statusChart = new Chart(document.getElementById('statusChart').getContext('2d'), {
                type: 'pie',
                data: { labels:['รอดำเนินการ','กำลังดำเนินการ','เสร็จสิ้น'], datasets:[{data:[pending,progress,completed],backgroundColor:['#f59e0b','#3b82f6','#10b981'],borderWidth:0}] },
                options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{position:'bottom'} } }
            });

            const daily = getDailyStats();
            if (dailyChart) dailyChart.destroy();
            dailyChart = new Chart(document.getElementById('dailyChart').getContext('2d'), {
                type: 'line',
                data: { labels:daily.labels, datasets:[{label:'จำนวน Ticket',data:daily.data,backgroundColor:'rgba(43,110,211,0.1)',borderColor:'#2b6ed3',tension:0.4,fill:true}] },
                options: { responsive:true, maintainAspectRatio:false }
            });
        }

        function getDailyStats() {
            const daily = {};
            filteredTickets.forEach(t => { if (t.timestamp) { const d = new Date(t.timestamp).toLocaleDateString('th-TH'); daily[d] = (daily[d]||0)+1; } });
            const start = new Date(document.getElementById('startDate').value);
            const end = new Date(document.getElementById('endDate').value);
            const labels=[], data=[], cur = new Date(start);
            let count = 0;
            while (cur <= end && count++ < 60) {
                const ds = cur.toLocaleDateString('th-TH');
                labels.push(ds); data.push(daily[ds]||0);
                cur.setDate(cur.getDate()+1);
            }
            return { labels, data };
        }

        function renderTable() {
            const tbody = document.getElementById('tableBody');
            const totalPages = Math.ceil(filteredTickets.length / rowsPerPage) || 1;
            const start = (currentPage-1)*rowsPerPage;
            const end = Math.min(start+rowsPerPage, filteredTickets.length);
            document.getElementById('totalPages').textContent = totalPages;
            document.getElementById('currentPage').textContent = currentPage;
            document.getElementById('paginationInfo').textContent = `แสดง ${filteredTickets.length ? start+1 : 0} - ${end} จาก ${filteredTickets.length} รายการ`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;
            if (!filteredTickets.length) { tbody.innerHTML = '<tr><td colspan="12" style="text-align:center;padding:40px;">ไม่มีข้อมูล</td></tr>'; return; }
            let html = '';
            for (let i = start; i < end; i++) {
                const t = filteredTickets[i];
                const sc = t.status==='รอดำเนินการ'?'status-pending':t.status==='กำลังดำเนินการ'?'status-progress':'status-completed';
                const imgCount = (t.imageUrls && t.imageUrls.length) || 0;
                const imgHtml = imgCount > 0 ? `<span class="img-thumb" onclick="viewImages('${t.ticketId}')"><i class="fas fa-image"></i> ${imgCount}</span>` : '-';
                html += `<tr>
                    <td>${i+1}</td>
                    <td><span class="ticket-id">${t.ticketId||'-'}</span></td>
                    <td>${formatDate(t.timestamp)}</td>
                    <td>${t.name||'-'}</td>
                    <td>${t.department||'-'}</td>
                    <td>${t.issueType||'-'}</td>
                    <td>${t.device||'-'}</td>
                    <td>${t.phone||'-'}</td>
                    <td><span class="status-badge ${sc}">${t.status||'รอดำเนินการ'}</span></td>
                    <td>${imgHtml}</td>
                    <td>${t.assignee||'-'}</td>
                    <td>${calcDur(t.timestamp)}</td>
                </tr>`;
            }
            tbody.innerHTML = html;
        }

        // ===== ฟังก์ชันแสดงรูปภาพใน Modal =====
        function viewImages(ticketId) {
            const ticket = allTickets.find(t => t.ticketId === ticketId);
            if (!ticket || !ticket.imageUrls || ticket.imageUrls.length === 0) {
                alert('ไม่มีรูปภาพสำหรับ Ticket นี้');
                return;
            }
            document.getElementById('imageModalTitle').textContent = `รูปภาพประกอบ: ${ticket.ticketId}`;
            const grid = document.getElementById('imageGrid');
            let html = '';
            ticket.imageUrls.forEach(url => {
                html += `<a href="${url}" target="_blank"><img src="${url}" alt="รูปภาพ ${ticket.ticketId}"/></a>`;
            });
            grid.innerHTML = html;
            document.getElementById('imageModal').classList.add('active');
        }

        function closeImageModal() {
            document.getElementById('imageModal').classList.remove('active');
        }
        // ปิด modal เมื่อคลิกพื้นหลัง
        document.getElementById('imageModal').addEventListener('click', function(e) {
            if (e.target === this) closeImageModal();
        });

        function formatDate(ts) { if(!ts) return '-'; try { return new Date(ts).toLocaleDateString('th-TH',{day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'}); } catch{return '-';} }
        function calcDur(ts) { if(!ts) return '-'; const h=Math.round((new Date()-new Date(ts))/3600000); return h<24?`${h} ชม.`:`${Math.floor(h/24)} วัน ${h%24} ชม.`; }
        function prevPage() { if(currentPage>1){currentPage--;renderTable();} }
        function nextPage() { if(currentPage<Math.ceil(filteredTickets.length/rowsPerPage)){currentPage++;renderTable();} }

        function exportToCSV() {
            if (!filteredTickets.length) { alert('ไม่มีข้อมูลที่จะส่งออก'); return; }
            const BOM = '\uFEFF';
            let csv = BOM + 'ลำดับ,Ticket ID,วันที่,ผู้แจ้ง,แผนก,ประเภท,อุปกรณ์,เบอร์โทร,สถานะ,รูปภาพ,ผู้รับผิดชอบ,ระยะเวลา\n';
            filteredTickets.forEach((t,i) => {
                const imgCount = (t.imageUrls && t.imageUrls.length) || 0;
                csv += `${i+1},"${t.ticketId||''}","${formatDate(t.timestamp)}","${t.name||''}","${t.department||''}","${t.issueType||''}","${t.device||''}","${t.phone||''}","${t.status||''}",${imgCount},"${t.assignee||''}","${calcDur(t.timestamp)}"\n`;
            });
            const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `IT_Report_${new Date().toISOString().split('T')[0]}.csv`;
            a.style.display = 'none';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
        }

        function printReport() { window.print(); }

        // กด Enter ในช่องค้นหา
        document.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') applyFilter();
        });
    </script>
</body>
